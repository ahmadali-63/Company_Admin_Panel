# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/company_admin_panel

# Generate with: openssl rand -base64 48
# Must be at least 32 characters. Use DIFFERENT values for the two secrets.
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list is allowed for multiple origins
CLIENT_URL=http://localhost:5173

# Used only by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-seeding

LOG_LEVEL=debug

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
